# Copie para ".env" (que está no .gitignore) e troque pelos seus valores.
# Os valores abaixo são EXEMPLOS FALSOS - nunca use estes valores de verdade.

# SQL Server (usuário sa). Evite ';' e '=' na senha: ela entra na connection string.
SA_PASSWORD=TroqueEstaSenha#1

# RabbitMQ
RABBITMQ_USER=troque_este_usuario
RABBITMQ_PASSWORD=TroqueEstaSenha#2

# Chave de assinatura do JWT (mínimo 32 caracteres). Usuários e Catálogo usam a MESMA chave.
JWT_SECRET=troque-esta-chave-com-no-minimo-32-caracteres

# New Relic (opcional no local). Para ligar: NEW_RELIC_ENABLED=true e informe a sua chave.
NEW_RELIC_ENABLED=false
NEW_RELIC_LICENSE_KEY=

# Caminhos de build (opcional). Só defina se os repositórios NÃO estiverem lado a lado.
# USUARIOS_CONTEXT=../FCG_Usuarios
# CATALOGO_CONTEXT=../FCG_Catalogo
# PAGAMENTOS_CONTEXT=../FCG_Pagamentos
# NOTIFICACOES_CONTEXT=../FCG_Notificacoes
